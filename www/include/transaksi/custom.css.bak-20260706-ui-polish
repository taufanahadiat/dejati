/* Category tabs dark-mode tuning */
html[data-theme-mode="dark"] #categoryTabs,
body.dark-mode #categoryTabs {
  background: #111827;
  border-color: #334155 !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat,
body.dark-mode #categoryTabs .order-cat {
  background: #1f2937;
  border-color: #334155;
  color: #cbd5e1 !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat .text-dark,
body.dark-mode #categoryTabs .order-cat .text-dark {
  color: #cbd5e1 !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat .material-symbols-outlined,
body.dark-mode #categoryTabs .order-cat .material-symbols-outlined {
  color: #94a3b8;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat:hover,
body.dark-mode #categoryTabs .order-cat:hover {
  background: #273449;
  border-color: #475569;
  color: #e2e8f0 !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat:hover .text-dark,
html[data-theme-mode="dark"] #categoryTabs .order-cat:hover .material-symbols-outlined,
body.dark-mode #categoryTabs .order-cat:hover .text-dark,
body.dark-mode #categoryTabs .order-cat:hover .material-symbols-outlined {
  color: #e2e8f0 !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat.active,
body.dark-mode #categoryTabs .order-cat.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff !important;
}

html[data-theme-mode="dark"] #categoryTabs .order-cat.active .text-dark,
html[data-theme-mode="dark"] #categoryTabs .order-cat.active .material-symbols-outlined,
body.dark-mode #categoryTabs .order-cat.active .text-dark,
body.dark-mode #categoryTabs .order-cat.active .material-symbols-outlined {
  color: #ffffff !important;
}

