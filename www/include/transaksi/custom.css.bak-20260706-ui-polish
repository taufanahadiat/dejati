.material-symbols-outlined {
  font-family: "Material Symbols Outlined";
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 48;
  font-size: 2rem;
}

.nav-pills-custom {
  border: 1px solid #dee2e6;
  border-radius: 0.5rem;
  background: #fff;
}

.nav-pills-custom .nav-link {
  width: 138px;
  height: 100px;
  padding-top: 2rem;
  padding-bottom: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
}

.nav-pills-custom .nav-link.active {
  background-color: #007bff;
  color: #fff !important;
}

.order-cat {
  border: 1px solid #dee2e6;
}

.product-card {
  border: 1px solid #dee2e6;
  border-radius: 0.5rem;
  padding: 1rem;
  text-align: center;
  transition: all 0.3s ease;
  cursor: pointer;
}

.product-card:hover {
  background-color: #f8f9fa;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

.product-card img {
  height: 150px;
  width: 150px;
  object-fit: cover;
  margin: 0 auto;
}

.product-no-img {
  border-radius: 5%;
  height: 150px;
  width: 150px;
  font-size: 2rem;
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #6c757d; /* optional: to match fallback bg */
  color: white; /* optional: text color */
  margin: 0 auto; /* center horizontally */
}

